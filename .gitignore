# Root .gitignore for Dhaka Tesla Pool

# Dependencies
node_modules/
*/node_modules/

# Environment variables
.env
.env.local
.env.production
.env.*.local
*.env
!.env.example
!*/.env.example

# Next.js build output
.next/
frontend/.next/
fontend/.next/
out/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / Editor files
.DS_Store
Thumbs.db
.history/
.vscode/
.idea/

# Testing coverage
coverage/
.nyc_output/

# Prisma generated or local sqlite (if any)
*.db
*.db-journal
