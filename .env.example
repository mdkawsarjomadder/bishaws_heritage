# Environment variables example for Dhaka Tesla Pool

# Backend Database URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dhaka_tesla_db?schema=public"

# Backend Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET="dhaka_tesla_pool_super_secret_jwt_key_2026"

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000"
