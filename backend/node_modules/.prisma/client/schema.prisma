generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
}

enum VehicleStatus {
  OFFLINE
  ONLINE
  IN_TRIP
}

enum RequestStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum PoolStatus {
  OPEN
  FULL
  STARTED
  COMPLETED
}

enum DhakaZone {
  BANANI
  GULSHAN_1
  GULSHAN_2
  MOHAKHALI
  FARM_GATE
  DHANMONDI
  MIRPUR
  UTTARA
}

model User {
  id                  String        @id @default(uuid())
  name                String
  email               String        @unique
  role                Role
  walletBalancePoysha BigInt        @default(100000)
  tesla               Tesla?
  rideRequests        RideRequest[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Tesla {
  id        String        @id @default(uuid())
  driverId  String        @unique
  driver    User          @relation(fields: [driverId], references: [id])
  modelName String        @default("Bullet")
  capacity  Int           @default(3)
  status    VehicleStatus @default(OFFLINE)
  pools     Pool[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Pool {
  id                 String        @id @default(uuid())
  teslaId            String
  tesla              Tesla         @relation(fields: [teslaId], references: [id])
  status             PoolStatus    @default(OPEN)
  totalSeatsOccupied Int           @default(0)
  rideRequests       RideRequest[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model RideRequest {
  id             String        @id @default(uuid())
  passengerId    String
  passenger      User          @relation(fields: [passengerId], references: [id])
  pickupZone     DhakaZone
  dropoffZone    DhakaZone
  seatsRequested Int           @default(1)
  status         RequestStatus @default(REQUESTED)
  farePoysha     BigInt
  poolId         String?
  pool           Pool?         @relation(fields: [poolId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
